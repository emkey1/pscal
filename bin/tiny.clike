#!/usr/bin/env clike

// Tiny language compiler (CLike version)
// Usage: clike bin/tiny source.tiny output.pbc

// --------- Utility: simple dirname ---------
str dirname(str path) {
  int len = length(path);
  if (len == 0) return "";
  int i = len;
  while (i > 0 && copy(path, i, 1) != "/" && copy(path, i, 1) != "\\") i = i - 1;
  if (i <= 1) return "/";
  return copy(path, 1, i - 1);
}

// --------- Read entire file ---------
str readFile(str path) {
  mstream ms = mstreamcreate();
  if (!mstreamloadfromfile(&ms, path)) {
    printf("Error: unable to read %s\n", path);
    halt(1);
  }
  str buf = mstreambuffer(ms);
  mstreamfree(&ms);
  return buf;
}

// Resolve repo root: prefer PSCALI_WORKSPACE_ROOT, then dirname(dirname(script))
str resolveRoot() {
  str root = getenv("PSCALI_WORKSPACE_ROOT");
  if (root == "") root = getenv("PSCAL_WORKSPACE_ROOT");
  if (root != "") return root;
  str script = paramstr(0);
  if (script == "") script = ".";
  root = dirname(dirname(script));
  if (root == "" || root == "/") root = ".";
  return root;
}

// VM headers live at <root>/src/... in an installed runtime and under
// <root>/components/pscal-core/src/... in a source checkout.
str coreHeader(str root, str rel) {
  str installed = root + "/src/" + rel;
  if (fileexists(installed)) return installed;
  str checkout = root + "/components/pscal-core/src/" + rel;
  if (fileexists(checkout)) return checkout;
  return installed;
}

// Derive default output path: replace trailing .tiny with .pbc, else append .pbc
str defaultOutPath(str src) {
  int len = length(src);
  if (len >= 5 && copy(src, len - 4, 5) == ".tiny") {
    return copy(src, 1, len - 5) + ".pbc";
  }
  return src + ".pbc";
}

str trimStr(str s) {
  int a = 1; int b = length(s);
  while (a <= b && copy(s, a, 1) <= " ") a = a + 1;
  while (b >= a && copy(s, b, 1) <= " ") b = b - 1;
  return copy(s, a, b - a + 1);
}

// Value of a decimal or 0x-prefixed hex literal; -1 if s is not one.
int parseIntLiteral(str s) {
  int n = length(s);
  if (n == 0) return -1;
  int v = 0;
  if (n > 2 && (copy(s, 1, 2) == "0x" || copy(s, 1, 2) == "0X")) {
    for (int i = 3; i <= n; i = i + 1) {
      str d = copy(s, i, 1);
      int dv;
      if (d >= "0" && d <= "9") dv = ord(d) - ord("0");
      else if (d >= "a" && d <= "f") dv = ord(d) - ord("a") + 10;
      else if (d >= "A" && d <= "F") dv = ord(d) - ord("A") + 10;
      else return -1;
      v = v * 16 + dv;
    }
    return v;
  }
  for (int i = 1; i <= n; i = i + 1) {
    str d = copy(s, i, 1);
    if (d < "0" || d > "9") return -1;
    v = v * 10 + ord(d) - ord("0");
  }
  return v;
}

// Header scanning. Every builtin call on a buffer costs time in proportion to
// its length, so these step through a header a line (or a match) at a time,
// never a character at a time.
str scanRest = "";
str nextLine() {
  int nl = pos("\n", scanRest);
  str line;
  if (nl == 0) { line = scanRest; scanRest = ""; }
  else { line = copy(scanRest, 1, nl - 1); scanRest = copy(scanRest, nl + 1, length(scanRest) - nl); }
  return line;
}

// The integer in the first "#define <name> <digits>" in buf (a trailing u/L
// suffix is ignored); -1 if there is none.
int defineValue(str buf, str name) {
  str key = "#define " + name;
  str rest = buf;
  str tail = "";
  while (1) {
    int p = pos(key, rest);
    if (p == 0) return -1;
    rest = copy(rest, p + length(key), length(rest) - p - length(key) + 1);
    str c = copy(rest, 1, 1);
    if (c == " " || c == "\t") { tail = copy(rest, 1, 32); break; }
    // else a longer name that merely starts with this one; keep looking
  }
  int n = length(tail);
  int k = 1;
  while (k <= n && (copy(tail, k, 1) == " " || copy(tail, k, 1) == "\t")) k = k + 1;
  int start = k;
  while (k <= n && copy(tail, k, 1) >= "0" && copy(tail, k, 1) <= "9") k = k + 1;
  if (k == start) return -1;
  return atoi(copy(tail, start, k - start));
}

// --------- Opcode loader ---------
// compiler/opcodes.def is the single source of truth for the opcode page.
// Each entry is OP(name, value, operands, stack_in, stack_out), and the
// values are pinned rather than positional, so they are read from the entry.
const int MAX_OPS = 512;
str opNames[MAX_OPS];
int opValues[MAX_OPS];
int opCount = 0;

void loadOpcodes(str root) {
  str header = coreHeader(root, "compiler/opcodes.def");
  if (!fileexists(header)) {
    printf("tiny: opcodes.def missing at %s\n", header);
    halt(1);
  }
  scanRest = readFile(header);
  while (length(scanRest) > 0) {
    str line = trimStr(nextLine());
    if (pos("OP(", line) != 1) continue;
    str rest = copy(line, 4, length(line) - 3);
    int comma = pos(",", rest);
    if (comma == 0) continue;
    str name = trimStr(copy(rest, 1, comma - 1));
    rest = copy(rest, comma + 1, length(rest) - comma);
    comma = pos(",", rest);
    if (comma == 0) continue;
    int value = parseIntLiteral(trimStr(copy(rest, 1, comma - 1)));
    if (value < 0) continue;
    if (opCount < MAX_OPS) { opNames[opCount] = name; opValues[opCount] = value; opCount = opCount + 1; }
  }
}

int opcode(str name) {
  for (int i = 0; i < opCount; i = i + 1) if (opNames[i] == name) return opValues[i];
  printf("Unknown opcode %s\n", name); halt(1); return -1;
}

// --------- Constants table ---------
int TYPE_INTEGER = 0;
int TYPE_STRING = 0;

// The VarType enum lives in core/var_type.h.
void loadTypeTags(str root) {
  str header = coreHeader(root, "core/var_type.h");
  if (!fileexists(header)) {
    // iOS workspace refresh can temporarily miss this header; use
    // canonical defaults (TYPE_INT32=2, TYPE_STRING=4) as fallback.
    TYPE_INTEGER = 2;
    TYPE_STRING = 4;
    printf("tiny: warning: var_type.h missing at %s (using fallback tags)\n", header);
    return;
  }

  scanRest = readFile(header);
  int inEnum = 0;
  int idx = 0;
  TYPE_INTEGER = 0;
  TYPE_STRING = 0;

  while (length(scanRest) > 0) {
    str trimmed = trimStr(nextLine());
    if (length(trimmed) >= 2 && copy(trimmed, 1, 2) == "//") continue;

    if (pos("typedef enum", trimmed) == 1) {
      inEnum = 1;
      idx = 0;
      continue;
    }
    if (!inEnum) continue;
    if (pos("} VarType", trimmed) == 1) break;

    int comma = pos(",", trimmed);
    if (comma == 0) continue;
    str entry = copy(trimmed, 1, comma - 1);
    int eq = pos("=", entry);
    if (eq > 0) {
      idx = atoi(trimStr(copy(entry, eq + 1, length(entry) - eq)));
      entry = copy(entry, 1, eq - 1);
    }
    entry = trimStr(entry);

    if (entry == "TYPE_INT32" || entry == "TYPE_INTEGER") TYPE_INTEGER = idx;
    if (entry == "TYPE_STRING") TYPE_STRING = idx;
    idx = idx + 1;
  }

  if (TYPE_INTEGER == 0 || TYPE_STRING == 0) {
    TYPE_INTEGER = 2;
    TYPE_STRING = 4;
    printf("tiny: warning: failed to resolve TYPE_INT32/TYPE_STRING from %s (using fallback tags)\n", header);
  }
}

const int MAX_CONST = 2048;
int constType[MAX_CONST];
str constVal[MAX_CONST];
int constCount = 0;

int addConstInt(int v) {
  str s = inttostr(v);
  for (int i = 0; i < constCount; i = i + 1)
    if (constType[i] == TYPE_INTEGER && constVal[i] == s) return i;
  int idx = constCount; constCount = constCount + 1;
  constType[idx] = TYPE_INTEGER; constVal[idx] = s; return idx;
}

int addConstStr(str s) {
  for (int i = 0; i < constCount; i = i + 1)
    if (constType[i] == TYPE_STRING && constVal[i] == s) return i;
  int idx = constCount; constCount = constCount + 1;
  constType[idx] = TYPE_STRING; constVal[idx] = s; return idx;
}

// --------- Bytecode buffer ---------
const int MAX_CODE = 65536;
int code[MAX_CODE];
int codeLen = 0;
void emit(int b) { code[codeLen] = b & 255; codeLen = codeLen + 1; }
void emitShort(int v) { emit((v >> 8) & 255); emit(v & 255); }
// Jump displacements are big-endian i32, relative to the next instruction.
void emitInt32(int v) { emit((v >> 24) & 255); emit((v >> 16) & 255); emit((v >> 8) & 255); emit(v & 255); }
void patchInt32(int at, int v) {
  code[at] = (v >> 24) & 255; code[at + 1] = (v >> 16) & 255;
  code[at + 2] = (v >> 8) & 255; code[at + 3] = v & 255;
}

// --------- Tokenizer / Parser ---------
const int MAX_TOK = 4096;
str tokType[MAX_TOK];
str tokVal[MAX_TOK];
int tokCount = 0; int tokPos = 0;

void tokenize(str src) {
  tokCount = 0;
  tokPos = 0;
  // strip {comments}
  while (1) {
    int a = pos("{", src); int b = pos("}", src);
    if (a > 0 && b > a) src = copy(src, 1, a - 1) + " " + copy(src, b + 1, length(src) - b);
    else break;
  }
  int i = 1; int n = length(src);
  while (i <= n) {
    while (i <= n && (copy(src, i, 1) == " " || copy(src, i, 1) == "\n" || copy(src, i, 1) == "\t" || copy(src, i, 1) == "\r")) i = i + 1;
    if (i > n) break;
    str c = copy(src, i, 1);
    if (c == "{") {
      while (i <= n && copy(src, i, 1) != "}") i = i + 1;
      i = i + 1; // skip closing brace
      continue;
    }
    if ((c >= "A" && c <= "Z") || (c >= "a" && c <= "z") || c == "_") {
      int j = i;
      while (j <= n) {
        str d = copy(src, j, 1);
        if (!((d >= "A" && d <= "Z") || (d >= "a" && d <= "z") || (d >= "0" && d <= "9") || d == "_")) break;
        j = j + 1;
      }
      str id = copy(src, i, j - i);
      str low = id;
      if (low == "if" || low == "then" || low == "else" || low == "end" || low == "repeat" || low == "until" || low == "read" || low == "write") tokType[tokCount] = low; else tokType[tokCount] = "IDENT";
      tokVal[tokCount] = id; tokCount = tokCount + 1; i = j; continue;
    }
    if (c >= "0" && c <= "9") {
      int j = i; while (j <= n && copy(src, j, 1) >= "0" && copy(src, j, 1) <= "9") j = j + 1;
      tokType[tokCount] = "NUMBER"; tokVal[tokCount] = copy(src, i, j - i); tokCount = tokCount + 1; i = j; continue;
    }
    if (c == ":" && i + 1 <= n && copy(src, i + 1, 1) == "=") { tokType[tokCount] = ":="; tokVal[tokCount] = ":="; tokCount = tokCount + 1; i = i + 2; continue; }
    if (c == "+" || c == "-" || c == "*" || c == "/" || c == "<" || c == "=" || c == ";" || c == "(" || c == ")") { tokType[tokCount] = c; tokVal[tokCount] = c; tokCount = tokCount + 1; i = i + 1; continue; }
    printf("Unknown token starting at %s\n", copy(src, i, 5)); halt(1);
  }
  tokType[tokCount] = "EOF"; tokVal[tokCount] = ""; tokCount = tokCount + 1;
}

str curType() { return tokType[tokPos]; }
str curVal() { return tokVal[tokPos]; }
void consume(str t) { if (curType() != t) { printf("Expected %s got %s\n", t, curType()); halt(1); } tokPos = tokPos + 1; }

// AST
const int N_PROGRAM=1, N_ASSIGN=2, N_READ=3, N_WRITE=4, N_IF=5, N_REPEAT=6, N_BINOP=7, N_NUM=8, N_VAR=9;
const int MAX_NODES = 4096;
int nType[MAX_NODES];
int nA[MAX_NODES];
str nS[MAX_NODES];
int nChildren[MAX_NODES][8];
int nChildCount[MAX_NODES];
int nCount = 0;

int newNode(int t) { int idx = nCount; nType[idx]=t; nA[idx]=0; nS[idx]=""; nChildCount[idx]=0; nCount = nCount + 1; return idx; }
void addChild(int p,int c){ nChildren[p][nChildCount[p]]=c; nChildCount[p]=nChildCount[p]+1; }

int parseProgram(); int parseStmtSeq(); int parseStatement(); int parseIf(); int parseRepeat(); int parseExpr(); int parseSimpleExpr(); int parseTerm(); int parseFactor();

int parseProgram(){ int p=newNode(N_PROGRAM); int seq=parseStmtSeq(); addChild(p,seq); consume("EOF"); return p; }
int parseStmtSeq(){ int seq=newNode(N_PROGRAM); addChild(seq, parseStatement()); while(curType()==";"){ consume(";"); addChild(seq, parseStatement()); } return seq; }
int parseStatement(){ str t=curType(); if(t=="if") return parseIf(); if(t=="repeat") return parseRepeat(); if(t=="read"){ consume("read"); int v=newNode(N_READ); nS[v]=curVal(); consume("IDENT"); return v;} if(t=="write"){ consume("write"); int w=newNode(N_WRITE); if(curType()!=";" && curType()!="until" && curType()!="end" && curType()!="else" && curType()!="EOF") addChild(w, parseExpr()); return w;} if(t=="IDENT"){ str name=curVal(); consume("IDENT"); consume(":="); int a=newNode(N_ASSIGN); nS[a]=name; addChild(a, parseExpr()); return a;} printf("Unexpected token %s\n", t); halt(1); return -1; }
int parseIf(){ consume("if"); int n = newNode(N_IF); int cond = parseExpr(); addChild(n, cond); consume("then"); addChild(n, parseStmtSeq()); if (curType() == "else") { consume("else"); addChild(n, parseStmtSeq()); } consume("end"); return n; }
int parseRepeat(){ consume("repeat"); int n=newNode(N_REPEAT); addChild(n, parseStmtSeq()); consume("until"); addChild(n, parseExpr()); return n; }
int parseExpr(){ int n=parseSimpleExpr(); if(curType()=="<"||curType()=="="){ str op=curType(); consume(op); int r=parseSimpleExpr(); int b=newNode(N_BINOP); nS[b]=op; addChild(b,n); addChild(b,r); return b;} return n; }
int parseSimpleExpr(){ int n=parseTerm(); while(curType()=="+"||curType()=="-"){ str op=curType(); consume(op); int r=parseTerm(); int b=newNode(N_BINOP); nS[b]=op; addChild(b,n); addChild(b,r); n=b;} return n; }
int parseTerm(){ int n=parseFactor(); while(curType()=="*"||curType()=="/"){ str op=curType(); consume(op); int r=parseFactor(); int b=newNode(N_BINOP); nS[b]=op; addChild(b,n); addChild(b,r); n=b;} return n; }
int parseFactor(){ str t=curType(); if(t=="("){ consume("("); int n=parseExpr(); consume(")"); return n;} if(t=="NUMBER"){ str v=curVal(); consume("NUMBER"); int n=newNode(N_NUM); nA[n]=atoi(v); return n;} if(t=="IDENT"){ str v=curVal(); consume("IDENT"); int n=newNode(N_VAR); nS[n]=v; return n;} printf("Unexpected token %s\n", t); halt(1); return -1; }

// Var collection
str vars[MAX_TOK]; int varCount=0;
int varIdx(str name){ for(int i=0;i<varCount;i=i+1) if(vars[i]==name) return i; return -1; }
void collectVars(int node){ int t=nType[node]; if(t==N_VAR||t==N_READ||t==N_ASSIGN){ str nm=nS[node]; if(varIdx(nm)<0){ vars[varCount]=nm; varCount=varCount+1; } } for(int i=0;i<nChildCount[node];i=i+1) collectVars(nChildren[node][i]); }
// Globals are defined, and their names pooled, in sorted order (as tools/tiny does).
void sortVars(){ for(int i=1;i<varCount;i=i+1){ str v=vars[i]; int j=i-1; while(j>=0 && v<vars[j]){ vars[j+1]=vars[j]; j=j-1; } vars[j+1]=v; } }

// Codegen helpers
int nameConstIdx[MAX_TOK];
int readConst, writeConst, trueConst, falseConst, typeIntConst;

// Globals are slot-addressed. The compiler writes a constant-pool NAME index
// in each u16 slot field, and the VM's load-time link step
// (compiler/bytecode_link.c) rewrites it into the resolved slot index.
void emitConst(int idx){ if(idx<=255){ emit(opcode("CONSTANT")); emit(idx);} else { emit(opcode("CONSTANT16")); emitShort(idx);} }
void emitDefine(str name){ emit(opcode("DEFINE_GLOBAL_SLOT")); emitShort(nameConstIdx[varIdx(name)]); emit(TYPE_INTEGER); emitShort(typeIntConst); }
void emitGetGlobal(str name){ emit(opcode("GET_GSLOT")); emitShort(nameConstIdx[varIdx(name)]); }
void emitGetGlobalAddr(str name){ emit(opcode("GET_GSLOT_ADDRESS")); emitShort(nameConstIdx[varIdx(name)]); }

void compileExpr(int node){ int t=nType[node]; if(t==N_NUM){ emitConst(addConstInt(nA[node])); return; } if(t==N_VAR){ emitGetGlobal(nS[node]); return; } if(t==N_BINOP){ compileExpr(nChildren[node][0]); compileExpr(nChildren[node][1]); str op=nS[node]; if(op=="+") emit(opcode("ADD")); else if(op=="-") emit(opcode("SUBTRACT")); else if(op=="*") emit(opcode("MULTIPLY")); else if(op=="/") emit(opcode("DIVIDE")); else if(op=="<") emit(opcode("LESS")); else if(op=="=") emit(opcode("EQUAL")); else { printf("Unknown op %s\n", op); halt(1);} return; } printf("Bad expr node %d\n", t); halt(1); }

void compileStmt(int node){
  int t = nType[node];
  if (t == N_ASSIGN) {
    compileExpr(nChildren[node][0]);
    emitGetGlobalAddr(nS[node]);
    emit(opcode("SWAP"));
    emit(opcode("SET_INDIRECT"));
    return;
  }
  if (t == N_READ) {
    emitGetGlobalAddr(nS[node]);
    emit(opcode("CALL_BUILTIN"));
    emitShort(readConst);
    emit(1);
    return;
  }
  if (t == N_WRITE) {
    if (nChildCount[node] == 0) {
      emitConst(trueConst);
      emit(opcode("CALL_BUILTIN"));
      emitShort(writeConst);
      emit(1);
    } else {
      emitConst(falseConst);
      compileExpr(nChildren[node][0]);
      emit(opcode("CALL_BUILTIN"));
      emitShort(writeConst);
      emit(2);
    }
    return;
  }
  if (t == N_IF) {
    compileExpr(nChildren[node][0]);
    emit(opcode("JUMP_IF_FALSE"));
    int jElse = codeLen;
    emitInt32(0);
    int thenNode = nChildren[node][1];
    for (int i = 0; i < nChildCount[thenNode]; i = i + 1) compileStmt(nChildren[thenNode][i]);
    if (nChildCount[node] > 2) {
      emit(opcode("JUMP"));
      int jEnd = codeLen;
      emitInt32(0);
      patchInt32(jElse, codeLen - (jElse + 4));
      int elseNode = nChildren[node][2];
      for (int i = 0; i < nChildCount[elseNode]; i = i + 1) compileStmt(nChildren[elseNode][i]);
      patchInt32(jEnd, codeLen - (jEnd + 4));
    } else {
      patchInt32(jElse, codeLen - (jElse + 4));
    }
    return;
  }
  if (t == N_REPEAT) {
    int loopStart = codeLen;
    int body = nChildren[node][0];
    for (int i = 0; i < nChildCount[body]; i = i + 1) compileStmt(nChildren[body][i]);
    compileExpr(nChildren[node][1]);
    emit(opcode("JUMP_IF_FALSE"));
    emitInt32(loopStart - (codeLen + 4));
    return;
  }
  printf("Bad stmt node %d\n", t);
  halt(1);
}

void compileProgram(int rootNode){
  for(int i=0;i<varCount;i=i+1) emitDefine(vars[i]);
  int seq=nChildren[rootNode][0];
  for(int i=0;i<nChildCount[seq];i=i+1) compileStmt(nChildren[seq][i]);
  emitConst(trueConst); emit(opcode("CALL_BUILTIN")); emitShort(writeConst); emit(1); emit(opcode("HALT"));
}

// --------- VM and container versions ---------
int vmVersion(str root){
  str verPath = coreHeader(root, "core/version.h");
  if (!fileexists(verPath)) {
    printf("tiny: version.h missing at %s\n", verPath);
    halt(1);
  }
  int v = defineValue(readFile(verPath), "PSCAL_VM_VERSION");
  if (v < 0) {
    printf("VM version not found\n");
    halt(1);
  }
  return v;
}

// PSB3_FORMAT_VERSION is the container-format epoch, distinct from the VM
// version above; it is defined in core/cache.c, next to the PSB3 reader and
// writer. An installed runtime carries headers only, so there it falls back
// to the epoch this writer implements. A file of any other epoch is rejected
// when the VM loads it, not misread.
const int PSB3_FORMAT_EPOCH = 5;

int formatVersion(str root){
  str cachePath = coreHeader(root, "core/cache.c");
  if (!fileexists(cachePath)) return PSB3_FORMAT_EPOCH;
  int v = defineValue(readFile(cachePath), "PSB3_FORMAT_VERSION");
  if (v < 0) {
    printf("tiny: PSB3_FORMAT_VERSION not found in %s\n", cachePath);
    halt(1);
  }
  return v;
}

// --------- PSB3 container ---------
// Mirrors psb3Write() in core/cache.c: a 16-byte header (magic 'PSB3',
// u16 format version, u16 VM version, u32 flags, u32 section count), a
// directory of (fourcc id, offset, length) u32 triples, then the section
// bodies, each starting on an 8-byte boundary. Header and directory fields
// are little-endian; section bodies use unsigned LEB128 varints.
const int MAX_SEC_BYTES = 262144;
int secBytes[MAX_SEC_BYTES];
int secBytesLen = 0;
str secId[8];
int secStart[8];
int secSize[8];
int secCount = 0;

void sByte(int b){ secBytes[secBytesLen] = b & 255; secBytesLen = secBytesLen + 1; }
void sVarint(int v){
  while (v >= 128) { sByte((v & 127) | 128); v = v >> 7; }
  sByte(v);
}
void sLE(long long v, int bytes){
  for (int i = 0; i < bytes; i = i + 1) { sByte((int)(v & 255)); v = v >> 8; }
}
void beginSection(str id){ secId[secCount] = id; secStart[secCount] = secBytesLen; }
void endSection(){ secSize[secCount] = secBytesLen - secStart[secCount]; secCount = secCount + 1; }

void buildSections(){
  secBytesLen = 0; secCount = 0;

  beginSection("CODE");
  sVarint(codeLen);
  sVarint(0); // cache_count: slot-addressed globals need no access caches
  for (int i = 0; i < codeLen; i = i + 1) sByte(code[i]);
  endSection();

  // tiny tracks no source lines: one run at line 0 covering the whole chunk,
  // as (run_count, pc_delta, zigzag line_delta).
  beginSection("LINE");
  if (codeLen == 0) sVarint(0);
  else { sVarint(1); sVarint(0); sVarint(0); }
  endSection();

  // Each constant: u32 type tag, then an i64 for an integer, or a presence
  // byte and a varint-length-prefixed string.
  beginSection("CONS");
  sVarint(constCount);
  for (int i = 0; i < constCount; i = i + 1) {
    sLE(constType[i], 4);
    if (constType[i] == TYPE_INTEGER) {
      sLE(atoi(constVal[i]), 8);
    } else {
      str s = constVal[i];
      sByte(1);
      sVarint(length(s));
      for (int j = 1; j <= length(s); j = j + 1) sByte(ord(s[j]));
    }
  }
  endSection();

  // No builtin lowercase-map entries; the fingerprint of an empty map is the
  // FNV1A64_OFFSET value cache.c starts from.
  beginSection("BMAP");
  sVarint(0);
  sLE(1469598103934665603, 8);
  endSection();

  beginSection("PROC");
  sVarint(0); // procedures
  sVarint(0); // constant globals
  endSection();

  beginSection("TYPE");
  sVarint(0);
  endSection();
}

void msAppendByte(mstream ms, int b){ mstreamappendbyte(ms, b & 255); }
void msAppendLE(mstream ms, int v, int bytes){
  for (int i = 0; i < bytes; i = i + 1) { msAppendByte(ms, v & 255); v = v >> 8; }
}
void msPadTo(mstream ms, int written, int target){
  for (int i = written; i < target; i = i + 1) msAppendByte(ms, 0);
}
int align8(int n){ return (n + 7) / 8 * 8; }

void writePbc(str outPath, int vmVer, int formatVer){
  buildSections();
  int offsets[8];
  int written = 16 + secCount * 12;
  int running = align8(written);
  for (int i = 0; i < secCount; i = i + 1) {
    offsets[i] = running;
    running = align8(running + secSize[i]);
  }

  mstream ms = mstreamcreate();
  msAppendLE(ms, 1347633715, 4); // 0x50534233 'PSB3', so the file starts "3BSP"
  msAppendLE(ms, formatVer, 2);
  msAppendLE(ms, vmVer, 2);
  // flags: bits 0..7 are the FrontendKind the chunk expects (cache.c's
  // PSB3_FLAG_FRONTEND_MASK), bits 8..31 reserved. 0 is FRONTEND_KIND_UNKNOWN
  // -- tiny indexes strings from 1 like Pascal, so the Pascal-compatible
  // defaults an unrecorded frontend gets are exactly right for it.
  msAppendLE(ms, 0, 4);
  msAppendLE(ms, secCount, 4);
  for (int i = 0; i < secCount; i = i + 1) {
    str id = secId[i];
    for (int c = 1; c <= 4; c = c + 1) msAppendByte(ms, ord(id[c]));
    msAppendLE(ms, offsets[i], 4);
    msAppendLE(ms, secSize[i], 4);
  }
  for (int i = 0; i < secCount; i = i + 1) {
    msPadTo(ms, written, offsets[i]);
    for (int k = 0; k < secSize[i]; k = k + 1) msAppendByte(ms, secBytes[secStart[i] + k]);
    written = offsets[i] + secSize[i];
    msPadTo(ms, written, align8(written));
    written = align8(written);
  }
  mstreamsavetofile(&ms, outPath);
  mstreamfree(&ms);
}

// --------- Main ---------
int main(){
  if (paramcount() < 1) { printf("Usage: clike bin/tiny <source.tiny> [out.pbc]\n"); return 1; }
  str srcPath = paramstr(1);
  str outPath;
  if (paramcount() >= 2) outPath = paramstr(2); else outPath = defaultOutPath(srcPath);
  str root = resolveRoot();
  if (!fileexists(srcPath)) { printf("tiny: source %s not found\n", srcPath); return 1; }
  loadOpcodes(root);
  loadTypeTags(root);
  int version = vmVersion(root);
  int format = formatVersion(root);
  str source = readFile(srcPath);
  // reset per compilation
  nCount = 0; varCount = 0; constCount = 0; codeLen = 0;
  tokenize(source);
  int ast = parseProgram();
  collectVars(ast);
  sortVars();
  readConst = addConstStr("read");
  writeConst = addConstStr("write");
  trueConst = addConstInt(1);
  falseConst = addConstInt(0);
  typeIntConst = addConstStr("integer");
  for (int i=0;i<varCount;i=i+1) nameConstIdx[i] = addConstStr(vars[i]);
  compileProgram(ast);
  writePbc(outPath, version, format);
  return 0;
}
