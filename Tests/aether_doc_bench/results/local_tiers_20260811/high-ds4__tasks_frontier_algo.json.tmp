                  "generation": {
                    "raw_text": "fn main() -> Void {\n    let a: Text = \"AGGTAB\";\n    let b: Text = \"GXTXAYB\";\n    let n: Int = string_len(a);\n    let m: Int = string_len(b);\n    let dp: Int[][] = [];\n    loop i in 0..n + 1 {\n        let row: Int[] = [];\n        loop j in 0..m + 1 {\n            row = row + [0];\n        }\n        dp = dp + [row];\n    }\n    loop i in 1..n + 1 {\n        loop j in 1..m + 1 {\n            if a[i - 1] == b[j - 1] {\n                dp[i][j] = dp[i - 1][j - 1] + 1;\n            } else {\n                dp[i][j] = max(dp[i - 1][j], dp[i][j - 1]);\n            }\n        }\n    }\n    let len: Int = dp[n][m];\n    let seq: Text = \"\";\n    let i: Int = n;\n    let j: Int = m;\n    loop i > 0 && j > 0 {\n        if a[i - 1] == b[j - 1] {\n            seq = a[i - 1] + seq;\n            i = i - 1;\n            j = j - 1;\n        } else {\n            if dp[i - 1][j] >= dp[i][j - 1] {\n                i = i - 1;\n            } else {\n                j = j - 1;\n            }\n        }\n    }\n    fx {\n        println(\"len=\", len);\n        println(\"lcs=\", seq);\n    }\n    ret;\n}\n__AETHER_BENCH_END__",
