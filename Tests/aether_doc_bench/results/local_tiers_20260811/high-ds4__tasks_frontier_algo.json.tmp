                    "raw_text": "```aether\n@pure\nfn findIndex(arr: Int[], key: Int) -> Int {\n    loop i in 0..length(arr) {\n        if arr[i] == key {\n            ret i;\n        }\n    }\n    ret -1;\n}\n\nfn main() -> Void {\n    let requests: Int[] = [1,2,3,1,4,2,5,1,3,4];\n    let capacity: Int = 3;\n    let cache: Int[] = [];\n    let evicted: Int[] = [];\n    let hits: Int = 0;\n    let misses: Int = 0;\n\n    loop i in 0..length(requests) {\n        let key: Int = requests[i];\n        let idx: Int = findIndex(cache, key);\n        if idx >= 0 {\n            hits = hits + 1;\n            let newCache: Int[] = [];\n            loop j in 0..length(cache) {\n                if j != idx {\n                    newCache = newCache + [cache[j]];\n                }\n            }\n            cache = [key] + newCache;\n        } else {\n            misses = misses + 1;\n            if length(cache) < capacity {\n                cache = [key] + cache;\n            } else {\n                let lru: Int = cache[length(cache) - 1];\n                evicted = evicted + [lru];\n                let rest: Int[] = cache[0..length(cache) - 1];\n                cache = [key] + rest;\n            }\n        }\n    }\n\n    fx {\n        println(\"hits=\", hits, \" misses=\", misses);\n        print(\"evicted:\");\n        loop i in 0..length(evicted) {\n            print(\" \", evicted[i]);\n        }\n        println(\"\");\n        println(\"resident=\", length(cache));\n    }\n    ret;\n}\n__AETHER_BENCH_END__",
