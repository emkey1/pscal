            {
              "task_id": "algo_interval_merge_gaps",
              "task_title": "algo interval merge gaps",
              "repeat_index": 0,
              "attempts": [
                {
                  "prompt_kind": "initial",
                  "prompt_approx_tokens": 13127,
                  "runner": "aether",
                  "generation": {
                    "raw_text": "type Interval {\n    lo: Int = 0;\n    hi: Int = 0;\n}\n\n@pure\nfn sortIntervals(arr: Interval[]) -> Interval[] {\n    loop i in 1..length(arr) {\n        let v: Interval = arr[i];\n        let j: Int = i - 1;\n        loop j >= 0 {\n            if arr[j].lo <= v.lo {\n                break;\n            }\n            arr[j + 1] = arr[j];\n            j = j - 1;\n        }\n        arr[j + 1] = v;\n    }\n    ret arr;\n}\n\nfn main() -> Void {\n    let lo: Int[] = [5,1,12,2,20,13];\n    let hi: Int[] = [7,4,15,6,22,18];\n    let intervals: Interval[] = [];\n    loop i in 0..length(lo) {\n        intervals = intervals + [new Interval { lo: lo[i], hi: hi[i] }];\n    }\n    intervals = sortIntervals(intervals);\n\n    let merged: Interval[] = [];\n    if length(intervals) > 0 {\n        let cur: Interval = intervals[0];\n        loop i in 1..length(intervals) {\n            if intervals[i].lo <= cur.hi {\n                cur.hi = max(cur.hi, intervals[i].hi);\n            } else {\n                merged = merged + [cur];\n                cur = intervals[i];\n            }\n        }\n        merged = merged + [cur];\n    }\n\n    fx {\n        loop i in 0..length(merged) {\n            println(\"merged [\", merged[i].lo, \",\", merged[i].hi, \"]\");\n        }\n    }\n\n    fx {\n        loop i in 1..length(merged) {\n            println(\"gap [\", merged[i-1].hi, \",\", merged[i].lo, \"] size=\", merged[i].lo - merged[i-1].hi);\n        }\n    }\n\n    let covered: Int = 0;\n    loop i in 0..length(merged) {\n        covered = covered + (merged[i].hi - merged[i].lo);\n    }\n\n    fx {\n        println(\"count=\", length(merged), \" covered=\", covered);\n    }\n\n    ret;\n}\n__AETHER_BENCH_END__",
