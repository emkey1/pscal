                    "raw_text": "```aether\nfn main() -> Void {\n    let from: Int[] = [5,5,2,3,3,1];\n    let to: Int[] = [2,0,3,1,0,0];\n    let n: Int = 6;\n    let indeg: Int[] = [0,0,0,0,0,0];\n    loop i in 0..length(to) {\n        indeg[to[i]] = indeg[to[i]] + 1;\n    }\n    let order: Int[] = [];\n    let placed: Int = 0;\n    loop placed < n {\n        let next: Int = -1;\n        loop i in 0..n {\n            if indeg[i] == 0 {\n                next = i;\n                break;\n            }\n        }\n        if next == -1 {\n            break;\n        }\n        order = order + [next];\n        placed = placed + 1;\n        indeg[next] = -1;\n        loop e in 0..length(from) {\n            if from[e] == next {\n                indeg[to[e]] = indeg[to[e]] - 1;\n            }\n        }\n    }\n    let acyclic: Bool = placed == n;\n    let acycText: Text = if acyclic { \"true\" } else { \"false\" };\n    fx {\n        print(\"order:\");\n        loop i in 0..length(order) {\n            print(\" \", order[i]);\n        }\n        println(\"\");\n        println(\"acyclic=\", acycText, \" placed=\", placed);\n    }\n    ret;\n}\n__AETHER_BENCH_END__",
