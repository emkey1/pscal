                  "runner": "aether",
                  "generation": {
                    "raw_text": "type Tally {\n    total: Int = 0;\n    count: Int = 0;\n}\n\nfn accumulate(start: Int, end: Int, t: Tally) -> Void {\n    loop i in start..end {\n        if i % 3 == 0 {\n            t.total = t.total + i;\n            t.count = t.count + 1;\n        }\n    }\n    ret;\n}\n\nfn main() -> Void {\n    let a: Tally = new Tally();\n    let b: Tally = new Tally();\n    par {\n        accumulate(0, 25, a);\n        accumulate(25, 50, b);\n    }\n    fx {\n        println(\"shardA total=\", a.total, \" count=\", a.count);\n        println(\"shardB total=\", b.total, \" count=\", b.count);\n        println(\"combined total=\", a.total + b.total, \" count=\", a.count + b.count);\n    }\n    ret;\n}\n__AETHER_BENCH_END__",
                    "usage": null,
