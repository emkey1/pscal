// 312_strings_005
// Concepts: Text processing with 0-based character indexing (s[0]..s[string_len(s) - 1]) — reverse by prepend-scan, palindrome check via string equality, vowel counting by per-char test, single-character frequency tally
// expect: word: rhythm
// expect: reversed: mhtyhr
// expect: is_palindrome = false
// expect: vowel_count = 0
// expect: freq('w') = 0

fn reverseStr(s: Text) -> Text {
    let out: Text = "";
    let n: Int = string_len(s);
    let i: Int = n - 1;
    loop i >= 0 {
        out = out + s[i];
        i = i - 1;
    }
    ret out;
}

fn isPalindrome(s: Text) -> Bool {
    let n: Int = string_len(s);
    let i: Int = 0;
    let j: Int = n - 1;
    loop i < j {
        if s[i] != s[j] { ret false; }
        i = i + 1;
        j = j - 1;
    }
    ret true;
}

fn isVowel(c: Text) -> Bool {
    if c == "a" { ret true; }
    if c == "e" { ret true; }
    if c == "i" { ret true; }
    if c == "o" { ret true; }
    if c == "u" { ret true; }
    ret false;
}

fn vowelCount(s: Text) -> Int {
    let count: Int = 0;
    let n: Int = string_len(s);
    loop i in 0..n {
        if isVowel(s[i]) { count = count + 1; }
    }
    ret count;
}

fn charFreq(s: Text, target: Text) -> Int {
    let count: Int = 0;
    let n: Int = string_len(s);
    loop i in 0..n {
        if s[i] == target { count = count + 1; }
    }
    ret count;
}

fn main() -> Void {
    let word: Text = "rhythm";
    let target: Text = "w";
    let rev: Text = reverseStr(word);
    let pal: Bool = isPalindrome(word);
    let vowels: Int = vowelCount(word);
    let freq: Int = charFreq(word, target);
    fx {
        println("word: ", word);
        println("reversed: ", rev);
        println("is_palindrome = ", pal);
        println("vowel_count = ", vowels);
        println("freq('", target, "') = ", freq);
    }
    ret;
}
