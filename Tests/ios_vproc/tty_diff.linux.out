== L5 ECHONL
echonl, no echo: keys "ab\n" echo "\r\n"
echonl, no echo: read "ab\n" EAGAIN
echonl, echo: keys "ab\n" echo "ab\r\n"
echonl, echo: read "ab\n" EAGAIN

== L5 echo goes through output processing
defaults: keys "ab\n" echo "ab\r\n"
defaults: keys "\rcd\r\r" echo "^Mcd^M^M"
defaults: keys "\n" echo "\r\n"
defaults: keys "x%" echo "x%"
defaults: keys "\ty\t" echo "\ty\t"
defaults: keys "\n" echo "\r\n"
defaults: read "ab\n" "\rcd\r\r\n" "x%" "\ty\t\n" EAGAIN
no opost: keys "ab\n" echo "ab\n"
no opost: keys "\rcd\r\r" echo "^Mcd^M^M"
no opost: keys "\n" echo "\n"
no opost: keys "x%" echo "x%"
no opost: keys "\ty\t" echo "\ty\t"
no opost: keys "\n" echo "\n"
no opost: read "ab\n" "\rcd\r\r\n" "x%" "\ty\t\n" EAGAIN
no onlcr: keys "ab\n" echo "ab\n"
