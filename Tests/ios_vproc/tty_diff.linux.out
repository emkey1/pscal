no onlcr: keys "\n" echo "\n"
no onlcr: keys "x%" echo "x%"
no onlcr: keys "\ty\t" echo "\ty\t"
no onlcr: keys "\n" echo "\n"
no onlcr: read "ab\n" "\rcd\r\r\n" "x%" "\ty\t\n" EAGAIN
ocrnl: keys "ab\n" echo "ab\r\n"
ocrnl: keys "\rcd\r\r" echo "^Mcd^M^M"
ocrnl: keys "\n" echo "\r\n"
ocrnl: keys "x%" echo "x%"
ocrnl: keys "\ty\t" echo "\ty\t"
ocrnl: keys "\n" echo "\r\n"
ocrnl: read "ab\n" "\rcd\r\r\n" "x%" "\ty\t\n" EAGAIN
onocr: keys "ab\n" echo "ab\r\n"
onocr: keys "\rcd\r\r" echo "^Mcd^M^M"
onocr: keys "\n" echo "\r\n"
onocr: keys "x%" echo "x%"
onocr: keys "\ty\t" echo "\ty\t"
onocr: keys "\n" echo "\r\n"
onocr: read "ab\n" "\rcd\r\r\n" "x%" "\ty\t\n" EAGAIN
onlret: keys "ab\n" echo "ab\r\n"
onlret: keys "\rcd\r\r" echo "^Mcd^M^M"
onlret: keys "\n" echo "\r\n"
onlret: keys "x%" echo "x%"
onlret: keys "\ty\t" echo "\ty\t"
onlret: keys "\n" echo "\r\n"
onlret: read "ab\n" "\rcd\r\r\n" "x%" "\ty\t\n" EAGAIN
olcuc: keys "ab\n" echo "AB\r\n"
olcuc: keys "\rcd\r\r" echo "^MCD^M^M"
olcuc: keys "\n" echo "\r\n"
olcuc: keys "x%" echo "X%"
olcuc: keys "\ty\t" echo "\tY\t"
olcuc: keys "\n" echo "\r\n"
olcuc: read "ab\n" "\rcd\r\r\n" "x%" "\ty\t\n" EAGAIN
tab3: keys "ab\n" echo "ab\r\n"
tab3: keys "\rcd\r\r" echo "^Mcd^M^M"
tab3: keys "\n" echo "\r\n"
tab3: keys "x%" echo "x%"
tab3: keys "\ty\t" echo "      y       "
tab3: keys "\n" echo "\r\n"
tab3: read "ab\n" "\rcd\r\r\n" "x%" "\ty\t\n" EAGAIN
onlret no onlcr: keys "ab\n" echo "ab\n"
onlret no onlcr: keys "\rcd\r\r" echo "^Mcd^M^M"
onlret no onlcr: keys "\n" echo "\n"
onlret no onlcr: keys "x%" echo "x%"
onlret no onlcr: keys "\ty\t" echo "\ty\t"
onlret no onlcr: keys "\n" echo "\n"
onlret no onlcr: read "ab\n" "\rcd\r\r\n" "x%" "\ty\t\n" EAGAIN

== L5 control bytes
isig off: keys "\x01\x1b\x1c\x1a\x03\x7f" echo "^A^[^\\^Z^C\b \b\b \b"
keys: keys "\x15" echo "\b \b\b \b\b \b\b \b\b \b\b \b\b \b\b \b"
nul and high: keys "\x00a\x80\x9f\xc3\xa9\xff\x11\x13" echo "^@a\x80\x9f\xc3\xa9\xff^Q^S"
keys: keys "\n" echo "\r\n"
nul and high: read "\x00a\x80\x9f\xc3\xa9\xff\x11\x13\n" EAGAIN
no echoctl: keys "\x01\x1b\x11\x13\n" echo "\x01\x1b\x11\x13\r\n"
no echoctl: read "\x01\x1b\x11\x13\n" EAGAIN

== L5 the end-of-file key
alone: keys "\x04" echo ""
alone: read EOF EAGAIN
after text: keys "abc\x04" echo "abc"
after text: read "abc" EAGAIN
after a line: keys "one\n\x04two\n" echo "one\r\ntwo\r\n"
after a line: read "one\n" EOF "two\n" EAGAIN
no echoctl: keys "\x04" echo ""
no echoctl: read EOF EAGAIN

== L5 ECHOPRT in steps
all gone, then more: keys "a" echo "a"
all gone, then more: keys "\x7f" echo "\\a/"
all gone, then more: keys "\x7f" echo ""
all gone, then more: keys "b" echo "b"
all gone, then more: keys "\n" echo "\r\n"
all gone, then more: read "b\n" EAGAIN
two gone, then more: keys "ab" echo "ab"
two gone, then more: keys "\x7f" echo "\\b"
two gone, then more: keys "\x7f" echo "a/"
two gone, then more: keys "c" echo "c"
two gone, then more: keys "\n" echo "\r\n"
two gone, then more: read "c\n" EAGAIN
one gone, then more: keys "ab" echo "ab"
one gone, then more: keys "\x7f" echo "\\b"
one gone, then more: keys "c" echo "/c"
one gone, then more: keys "\n" echo "\r\n"
one gone, then more: read "ac\n" EAGAIN
newline while open: keys "ab" echo "ab"
newline while open: keys "\x7f" echo "\\b"
newline while open: keys "\n" echo "\r\n"
newline while open: read "a\n" EAGAIN
eof while open: keys "ab" echo "ab"
eof while open: keys "\x7f" echo "\\b"
eof while open: keys "\x04" echo ""
eof while open: keys "\n" echo "\r\n"
eof while open: read "a" "\n" EAGAIN
kill while open: keys "ab" echo "ab"
kill while open: keys "\x7f" echo "\\b"
kill while open: keys "\x15" echo "a/"
kill while open: keys "c\n" echo "c\r\n"
kill while open: read "c\n" EAGAIN
kill while open, echoke: keys "abc" echo "abc"
kill while open, echoke: keys "\x7f" echo "\\c"
kill while open, echoke: keys "\x15" echo "ba/"
kill while open, echoke: keys "c\n" echo "c\r\n"
kill while open, echoke: read "c\n" EAGAIN
werase while open: keys "x yz" echo "x yz"
werase while open: keys "\x7f" echo "\\z"
werase while open: keys "\x17" echo "y"
werase while open: keys "c\n" echo "/c\r\n"
werase while open: read "x c\n" EAGAIN
reprint while open: keys "abc" echo "abc"
reprint while open: keys "\x7f" echo "\\c"
reprint while open: keys "\x12" echo "/^R\r\nab"
reprint while open: keys "c\n" echo "c\r\n"
reprint while open: read "abc\n" EAGAIN
lnext while open: keys "abc" echo "abc"
lnext while open: keys "\x7f" echo "\\c"
lnext while open: keys "\x16" echo "/^\b"
lnext while open: keys "\x7f" echo "^?"
lnext while open: keys "\n" echo "\r\n"
lnext while open: read "ab\x7f\n" EAGAIN
a tab: keys "a\tb" echo "a\tb"
a tab: keys "\x7f" echo "\\b"
a tab: keys "\x7f" echo "\t"
a tab: keys "\x7f" echo "a/"
a tab: keys "c\n" echo "c\r\n"
a tab: read "c\n" EAGAIN
control, echoctl: keys "a\x01b" echo "a^Ab"
control, echoctl: keys "\x7f" echo "\\b"
control, echoctl: keys "\x7f" echo "^A"
control, echoctl: keys "\x7f" echo "a/"
control, echoctl: keys "c\n" echo "c\r\n"
control, echoctl: read "c\n" EAGAIN
control, no echoctl: keys "a\x01b" echo "a\x01b"
control, no echoctl: keys "\x7f" echo "\\b"
control, no echoctl: keys "\x7f" echo "\x01"
control, no echoctl: keys "\x7f" echo "a/"
control, no echoctl: keys "c\n" echo "c\r\n"
control, no echoctl: read "c\n" EAGAIN
multibyte: keys "a\xc3\xa9b" echo "a\xc3\xa9b"
multibyte: keys "\x7f" echo "\\b"
multibyte: keys "\x7f" echo "\xc3\xa9"
multibyte: keys "\x7f" echo "a/"
multibyte: keys "c\n" echo "c\r\n"
multibyte: read "c\n" EAGAIN
multibyte, off: keys "a\xc3\xa9b" echo "a\xc3\xa9b"
multibyte, off: keys "\x7f" echo "\\b"
multibyte, off: keys "\x7f" echo "\xa9"
multibyte, off: keys "\x7f" echo "\xc3"
multibyte, off: keys "\x7f" echo "a/"
multibyte, off: keys "c\n" echo "c\r\n"
multibyte, off: read "c\n" EAGAIN
no echo: keys "ab" echo ""
no echo: keys "\x7f" echo ""
no echo: keys "c\n" echo ""
no echo: read "ac\n" EAGAIN
echoctl key closing: keys "ab" echo "ab"
echoctl key closing: keys "\x7f" echo "\\b"
echoctl key closing: keys "\x01" echo "/^A"
echoctl key closing: keys "\n" echo "\r\n"
echoctl key closing: read "a\x01\n" EAGAIN
newline while open, then more: keys "ab" echo "ab"
newline while open, then more: keys "\x7f" echo "\\b"
newline while open, then more: keys "\n" echo "\r\n"
newline while open, then more: keys "c" echo "/c"
newline while open, then more: keys "\n" echo "\r\n"
newline while open, then more: read "a\n" "c\n" EAGAIN
eof while open, then more: keys "ab" echo "ab"
eof while open, then more: keys "\x7f" echo "\\b"
eof while open, then more: keys "\x04" echo ""
eof while open, then more: keys "c" echo "/c"
eof while open, then more: keys "\n" echo "\r\n"
eof while open, then more: read "a" "c\n" EAGAIN
VEOL while open: keys "ab" echo "ab"
VEOL while open: keys "\x7f" echo "\\b"
VEOL while open: keys "%" echo "%"
VEOL while open: keys "c" echo "/c"
VEOL while open: keys "\x7f" echo "\\c/"
VEOL while open: keys "&" echo "&"
VEOL while open: keys "d" echo "d"
VEOL while open: keys "\n" echo "\r\n"
VEOL while open: read "a%" "&" "d\n" EAGAIN

== L5 the kill key with nothing to kill
no echok: keys "\x15" echo ""
no echok: keys "\n" echo "\r\n"
no echok: read "\n" EAGAIN
echok: keys "\x15" echo ""
echok: keys "\n" echo "\r\n"
echok: read "\n" EAGAIN
echok echoke: keys "\x15" echo ""
echok echoke: keys "\n" echo "\r\n"
echok echoke: read "\n" EAGAIN
echoprt: keys "\x15" echo ""
echoprt: keys "\n" echo "\r\n"
echoprt: read "\n" EAGAIN

== L5 the column with OPOST clear
letters: keys "ab" echo "ab"
letters: then a tab: "        |"
a control: keys "\x01" echo "^A"
a control: then a tab: "      |"
a tab: keys "\t" echo "\t"
a tab: then a tab: "        |"
a letter erased: keys "ab\x7f" echo "ab\b \b"
a letter erased: then a tab: "        |"
a tab erased: keys "a\t\x7f" echo "a\t\b\b\b\b\b\b\b"
a tab erased: then a tab: "        |"
a control erased: keys "a\x01\x7f" echo "a^A\b \b\b \b"
a control erased: then a tab: "      |"
a letter, then a line: keys "ab\n" echo "ab\n"
a letter, then a line: then a tab: "        |"

== L5 a mode with the column kept
a key, then raw: keys "ab" echo "ab"
then a tab: "      |"

== L3 L5 VLNEXT and the column
tab after a literal letter: keys "\x16q\t" echo "^\bq\t"
tab after a literal letter: keys "\x7f" echo "\b\b\b\b\b\b\b"
tab after a literal letter: keys "\x7f" echo "\b \b"
tab after a literal letter: keys "\n" echo "\r\n"
tab after a literal letter: read "\n" EAGAIN
tab after a literal control: keys "\x16\x01\t" echo "^\b^A\t"
tab after a literal control: keys "\x7f" echo "\b\b\b\b\b\b"
tab after a literal control: keys "\x7f" echo "\b \b\b \b"
tab after a literal control: keys "\n" echo "\r\n"
tab after a literal control: read "\n" EAGAIN
a literal tab: keys "\x16\t" echo "^\b\t"
a literal tab: keys "\x7f" echo "\b\b\b\b\b\b\b\b"
a literal tab: keys "\n" echo "\r\n"
a literal tab: read "\n" EAGAIN
a literal erase erased: keys "ab\x16\x7f" echo "ab^\b^?"
a literal erase erased: keys "\x7f" echo "\b \b\b \b"
a literal erase erased: keys "\n" echo "\r\n"
a literal erase erased: read "ab\n" EAGAIN
erase of a next that's pending: keys "ab\x16" echo "ab^\b"
erase of a next that's pending: keys "\x7f" echo "^?"
erase of a next that's pending: keys "\x7f" echo "\b \b\b \b"
erase of a next that's pending: keys "\n" echo "\r\n"
erase of a next that's pending: read "ab\n" EAGAIN
newline after next: keys "ab\x16" echo "ab^\b"
newline after next: keys "\n" echo "^J"
newline after next: keys "\n" echo "\r\n"
newline after next: read "ab\n\n" EAGAIN
no echoctl, the key: keys "ab\x16" echo "ab"
no echoctl, the key: keys "c" echo "c"
no echoctl, the key: keys "\n" echo "\r\n"
no echoctl, the key: read "abc\n" EAGAIN
literal at werase: keys "x y\x16\x01" echo "x y^\b^A"
literal at werase: keys "\x17" echo "\b \b\b \b\b \b"
literal at werase: keys "\n" echo "\r\n"
literal at werase: read "x \n" EAGAIN
literal space at werase: keys "x y\x16 " echo "x y^\b "
literal space at werase: keys "\x17" echo "\b \b\b \b"
literal space at werase: keys "\n" echo "\r\n"
literal space at werase: read "x \n" EAGAIN

== L5 the line's first column
reprint with output before: keys "ab" echo "ab"
reprint with output before: keys "\x12" echo "^R\r\nab"
reprint with output before: keys "\t" echo "\t"
reprint with output before: keys "\x7f" echo "\b\b\b\b\b\b"
reprint with output before: keys "\x7f\x7f" echo "\b \b\b \b"
reprint with output before: keys "\n" echo "\r\n"
reprint with output before: read "\n" EAGAIN
kill and output: keys "ab" echo "ab"
kill and output: keys "\x15" echo "\b \b\b \b"
kill and output: keys "c\t" echo "c\t"
kill and output: keys "\x7f" echo "\b\b\b\b"
kill and output: keys "\x7f" echo "\b \b"
kill and output: keys "\n" echo "\r\n"
kill and output: read "\n" EAGAIN
erase and output: keys "ab" echo "ab"
erase and output: keys "\x7f\x7f" echo "\b \b\b \b"
erase and output: keys "c\t" echo "c\t"
erase and output: keys "\x7f" echo "\b\b\b\b"
erase and output: keys "\x7f" echo "\b \b"
erase and output: keys "\n" echo "\r\n"
erase and output: read "\n" EAGAIN
first key unseen: keys "ab" echo ""
first key unseen: keys "c\t" echo "c\t"
first key unseen: keys "\x7f" echo "\b\b\b\b\b"
first key unseen: keys "\x7f" echo "\b \b"
first key unseen: keys "\n" echo "\r\n"
first key unseen: read "ab\n" EAGAIN
typed return, no echoctl: keys "\r" echo "\r"
typed return, no echoctl: keys "\t" echo "\t"
typed return, no echoctl: keys "\x7f" echo "\b\b\b\b\b\b\b\b"
typed return, no echoctl: keys "\x7f" echo ""
typed return, no echoctl: keys "\n" echo "\r\n"
typed return, no echoctl: read "\n" EAGAIN
typed return at column 0, onocr: keys "\r" echo ""
typed return at column 0, onocr: keys "a\r" echo "a\r"
typed return at column 0, onocr: keys "\n" echo "\r\n"
typed return at column 0, onocr: read "\ra\r\n" EAGAIN
typed return, ocrnl: keys "a\r" echo "a\n"
typed return, ocrnl: keys "\n" echo "\r\n"
typed return, ocrnl: read "a\r\n" EAGAIN

== L3 a character set to nothing
VERASE 0: keys "a\x00b\n" echo "a^@b\r\n"
VERASE 0: read "a\x00b\n" EAGAIN
VKILL 0: keys "a\x00b\n" echo "a^@b\r\n"
VKILL 0: read "a\x00b\n" EAGAIN
VEOF 0: keys "a\x00b\n" echo "a^@b\r\n"
VEOF 0: read "a\x00b\n" EAGAIN
the rest 0: keys "a\x00b\n" echo "a^@b\r\n"
the rest 0: read "a\x00b\n" EAGAIN

== L1 cflags on a pty
set c=0 reads b0
set c=bf reads bf
set c=1f reads bf
set c=10 reads b0
set c=20 reads b0
set c=30 reads b0
set c=40 reads f0
set c=100 reads b0
set c=200 reads 2b0
set c=400 reads 4b0
set c=800 reads 8b0
set c=1000 reads 10b0
set c=1001 reads 10b1
set c=7fffffff reads 5ffffeff
set c=d reads bd
set c=8d reads bd

== L7 flags Linux keeps and doesn't act on
all kept: i=ffffb817 o=fffffffe l=fffffffe
xcase: keys "aB\\C\n" echo "AB\\C\r\n"
xcase: read "ab\\c\n" EAGAIN
xcase output "AB\\C"
flusho pendin: keys "aB\n" echo "aB\r\n"
flusho pendin: read "aB\n" EAGAIN
flusho output "out"
l=da3b

== L5 erasing across a tab
at the start: keys "\t" echo "\t"
at the start: keys "\x7f" echo "\b\b\b\b\b\b\b\b"
at the start: keys "\x7f" echo ""
at the start: keys "\n" echo "\r\n"
at the start: read "\n" EAGAIN
after letters: keys "ab\t" echo "ab\t"
after letters: keys "\x7f" echo "\b\b\b\b\b\b"
after letters: keys "\x7f" echo "\b \b"
after letters: keys "\n" echo "\r\n"
after letters: read "a\n" EAGAIN
full stop: keys "abcdefgh\t" echo "abcdefgh\t"
full stop: keys "\x7f" echo "\b\b\b\b\b\b\b\b"
full stop: keys "\x7f" echo "\b \b"
full stop: keys "\n" echo "\r\n"
full stop: read "abcdefg\n" EAGAIN
two tabs: keys "\t\t" echo "\t\t"
two tabs: keys "\x7f" echo "\b\b\b\b\b\b\b\b"
two tabs: keys "\x7f" echo "\b\b\b\b\b\b\b\b"
two tabs: keys "\n" echo "\r\n"
two tabs: read "\n" EAGAIN
tab between: keys "a\tb\t" echo "a\tb\t"
tab between: keys "\x7f" echo "\b\b\b\b\b\b\b"
tab between: keys "\x7f" echo "\b \b"
tab between: keys "\n" echo "\r\n"
tab between: read "a\t\n" EAGAIN
after a control: keys "\x01\t" echo "^A\t"
after a control: keys "\x7f" echo "\b\b\b\b\b\b"
after a control: keys "\x7f" echo "\b \b\b \b"
after a control: keys "\n" echo "\r\n"
after a control: read "\n" EAGAIN
after a control, no echoctl: keys "\x01\t" echo "\x01\t"
after a control, no echoctl: keys "\x7f" echo "\b\b\b\b\b\b\b\b"
after a control, no echoctl: keys "\x7f" echo ""
after a control, no echoctl: keys "\n" echo "\r\n"
after a control, no echoctl: read "\n" EAGAIN
after output: keys "\t" echo "\t"
after output: keys "\x7f" echo "\b\b\b\b\b"
after output: keys "\x7f" echo ""
after output: keys "\n" echo "\r\n"
after output: read "\n" EAGAIN
after output and letters: keys "ab\t" echo "ab\t"
after output and letters: keys "\x7f" echo "\b\b\b"
after output and letters: keys "\x7f" echo "\b \b"
after output and letters: keys "\n" echo "\r\n"
after output and letters: read "a\n" EAGAIN
after long output: keys "\t" echo "\t"
after long output: keys "\x7f" echo "\b\b\b\b\b\b"
after long output: keys "\x7f" echo ""
after long output: keys "\n" echo "\r\n"
after long output: read "\n" EAGAIN
after output with a line end: keys "\t" echo "\t"
after output with a line end: keys "\x7f" echo "\b\b\b\b\b"
after output with a line end: keys "\x7f" echo ""
after output with a line end: keys "\n" echo "\r\n"
after output with a line end: read "\n" EAGAIN
after output with a return: keys "\t" echo "\t"
after output with a return: keys "\x7f" echo "\b\b\b\b\b\b\b"
after output with a return: keys "\x7f" echo ""
after output with a return: keys "\n" echo "\r\n"
after output with a return: read "\n" EAGAIN
after output with a tab: keys "\t" echo "\t"
after output with a tab: keys "\x7f" echo "\b\b\b\b\b\b\b"
after output with a tab: keys "\x7f" echo ""
after output with a tab: keys "\n" echo "\r\n"
after output with a tab: read "\n" EAGAIN
after output with a backspace: keys "\t" echo "\t"
after output with a backspace: keys "\x7f" echo "\b\b\b\b\b\b"
after output with a backspace: keys "\x7f" echo ""
after output with a backspace: keys "\n" echo "\r\n"
after output with a backspace: read "\n" EAGAIN
after output, control: keys "\x01\t" echo "^A\t"
after output, control: keys "\x7f" echo "\b\b\b"
after output, control: keys "\x7f" echo "\b \b\b \b"
after output, control: keys "\n" echo "\r\n"
after output, control: read "\n" EAGAIN
no echoe: keys "ab\t" echo "ab\t"
no echoe: keys "\x7f" echo "^?"
no echoe: keys "\x7f" echo "^?"
no echoe: keys "\n" echo "\r\n"
no echoe: read "a\n" EAGAIN
output during a line: keys "ab" echo "ab"
output during a line: keys "\t" echo "\t"
output during a line: keys "\x7f" echo "\b\b\b\b\b\b"
output during a line: keys "\x7f\x7f" echo "\b \b\b \b"
output during a line: keys "\n" echo "\r\n"
output during a line: read "\n" EAGAIN
output with no opost: keys "\t" echo "\t"
output with no opost: keys "\x7f" echo "\b\b\b\b\b\b\b\b"
output with no opost: keys "\n" echo "\r\n"
output with no opost: read "\n" EAGAIN
second line: keys "abc\n" echo "abc\r\n"
second line: keys "\t" echo "\t"
second line: keys "\x7f" echo "\b\b\b\b\b\b\b\b"
second line: keys "\n" echo "\r\n"
second line: read "abc\n" "\n" EAGAIN
second line, no onlcr: keys "abc\n" echo "abc\n"
second line, no onlcr: keys "\t" echo "\t"
second line, no onlcr: keys "\x7f" echo "\b\b\b\b\b"
second line, no onlcr: keys "\n" echo "\n"
second line, no onlcr: read "abc\n" "\n" EAGAIN
tab3: keys "ab\t" echo "ab      "
tab3: keys "\x7f" echo "\b\b\b\b\b\b"
tab3: keys "\x7f\x7f" echo "\b \b\b \b"
tab3: keys "\n" echo "\r\n"
tab3: read "\n" EAGAIN

