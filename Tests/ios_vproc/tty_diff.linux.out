master: i=500 o=5 c=bf l=8a3b line=0 cc=031c7f150400010011131a00120f1716000000
TIOCGWINSZ: 0
winsize: 0 0 0 0

== L1 L5 L7 L16 through the host's own numbers
speed is 38400: yes yes
cs8 1 cread 1
ICRNL 1
IXON 1
ISTRIP 0
IUTF8 0
OPOST 1
ONLCR 1
ISIG 1
ICANON 1
ECHO 1
ECHOE 1
ECHOK 1
ECHONL 0
NOFLSH 0
TOSTOP 0
ECHOCTL 1
ECHOPRT 0
ECHOKE 1
IEXTEN 1
ISTRIP set: 1
ISTRIP clear: 0
IUTF8 set: 1
IUTF8 clear: 0
IGNBRK set: 1
IGNBRK clear: 0
BRKINT set: 1
BRKINT clear: 0
IGNPAR set: 1
IGNPAR clear: 0
PARMRK set: 1
PARMRK clear: 0
INPCK set: 1
INPCK clear: 0
IMAXBEL set: 1
IMAXBEL clear: 0
TAB3 set: 1
TAB3 clear: 0
ECHONL set: 1
ECHONL clear: 0
TOSTOP set: 1
TOSTOP clear: 0
ECHOPRT set: 1
ECHOPRT clear: 0
ECHOKE set: 1
ECHOKE clear: 0
CSTOPB set: 1
CSTOPB clear: 0
PARENB set: 0
PARENB clear: 0
cs7: size 30
9600: d
9600 reads back: 1
typed: keys "one\n" echo "one\r\n"
tcflush: 0
tcflush: read EAGAIN
tcdrain: 0
TIOCOUTQ: 0
value 0
TIOCEXCL: 0
open: EBUSY
TIOCNXCL: 0
open: 0
TIOCNOTTY: ENOTTY
TIOCSTI: EIO

== L3 VWERASE
plain: keys "foo bar\x17" echo "foo bar\b \b\b \b\b \b"
plain: keys "\n" echo "\r\n"
plain: read "foo \n" EAGAIN
twice: keys "foo bar\x17\x17" echo "foo bar\b \b\b \b\b \b\b \b\b \b\b \b\b \b"
twice: keys "\n" echo "\r\n"
twice: read "\n" EAGAIN
trailing space: keys "foo bar   \x17" echo "foo bar   \b \b\b \b\b \b\b \b\b \b\b \b"
trailing space: keys "\n" echo "\r\n"
trailing space: read "foo \n" EAGAIN
punctuation: keys "foo-bar\x17" echo "foo-bar\b \b\b \b\b \b"
punctuation: keys "\n" echo "\r\n"
punctuation: read "foo-\n" EAGAIN
punctuation twice: keys "foo-bar\x17\x17" echo "foo-bar\b \b\b \b\b \b\b \b\b \b\b \b\b \b"
punctuation twice: keys "\n" echo "\r\n"
punctuation twice: read "\n" EAGAIN
underscore: keys "foo_bar baz\x17\x17" echo "foo_bar baz\b \b\b \b\b \b\b \b\b \b\b \b\b \b\b \b\b \b\b \b\b \b"
underscore: keys "\n" echo "\r\n"
underscore: read "\n" EAGAIN
digits: keys "a1 b2\x17" echo "a1 b2\b \b\b \b"
digits: keys "\n" echo "\r\n"
digits: read "a1 \n" EAGAIN
tab: keys "one\ttwo\x17" echo "one\ttwo\b \b\b \b\b \b"
tab: keys "\n" echo "\r\n"
tab: read "one\t\n" EAGAIN
tab twice: keys "one\ttwo\x17\x17" echo "one\ttwo\b \b\b \b\b \b\b\b\b\b\b\b \b\b \b\b \b"
tab twice: keys "\n" echo "\r\n"
tab twice: read "\n" EAGAIN
control: keys "ab\x01cd\x17" echo "ab^Acd\b \b\b \b"
control: keys "\n" echo "\r\n"
control: read "ab\x01\n" EAGAIN
high bytes: keys "ab\xc3\xa9cd\x17" echo "ab\xc3\xa9cd\b \b\b \b"
high bytes: keys "\n" echo "\r\n"
high bytes: read "ab\xc3\xa9\n" EAGAIN
all space: keys "    \x17" echo "    \b \b\b \b\b \b\b \b"
all space: keys "\n" echo "\r\n"
all space: read "\n" EAGAIN
nothing: keys "\x17" echo ""
nothing: keys "\n" echo "\r\n"
nothing: read "\n" EAGAIN
other line: keys "one\n\x17" echo "one\r\n"
other line: keys "\n" echo "\r\n"
other line: read "one\n" "\n" EAGAIN
no echoe: keys "foo bar\x17" echo "foo bar\b \b\b \b\b \b"
no echoe: keys "\n" echo "\r\n"
no echoe: read "foo \n" EAGAIN
no echo: keys "foo bar\x17" echo ""
no echo: keys "\n" echo ""
no echo: read "foo \n" EAGAIN
no iexten: keys "foo bar\x17" echo "foo bar^W"
no iexten: keys "\n" echo "\r\n"
no iexten: read "foo bar\x17\n" EAGAIN

== L3 VREPRINT
plain: keys "abc\x12" echo "abc^R\r\nabc"
plain: keys "\n" echo "\r\n"
plain: read "abc\n" EAGAIN
then more: keys "abc\x12d" echo "abc^R\r\nabcd"
then more: keys "\n" echo "\r\n"
then more: read "abcd\n" EAGAIN
empty: keys "\x12" echo "^R\r\n"
empty: keys "\n" echo "\r\n"
empty: read "\n" EAGAIN
after a line: keys "one\nab\x12" echo "one\r\nab^R\r\nab"
after a line: keys "\n" echo "\r\n"
after a line: read "one\n" "ab\n" EAGAIN
after a line, empty: keys "one\n\x12" echo "one\r\n^R\r\n"
after a line, empty: keys "\n" echo "\r\n"
after a line, empty: read "one\n" "\n" EAGAIN
control in line: keys "a\x01b\x12" echo "a^Ab^R\r\na^Ab"
control in line: keys "\n" echo "\r\n"
control in line: read "a\x01b\n" EAGAIN
tab in line: keys "a\tb\x12" echo "a\tb^R\r\na\tb"
tab in line: keys "\n" echo "\r\n"
tab in line: read "a\tb\n" EAGAIN
no echo: keys "abc\x12" echo ""
no echo: keys "\n" echo ""
no echo: read "abc\x12\n" EAGAIN
no echoctl: keys "abc\x12" echo "abc\x12\r\nabc"
no echoctl: keys "\n" echo "\r\n"
no echoctl: read "abc\n" EAGAIN
no iexten: keys "abc\x12" echo "abc^R"
no iexten: keys "\n" echo "\r\n"
no iexten: read "abc\x12\n" EAGAIN

== L3 VLNEXT
control: keys "\x16\x01" echo "^\b^A"
control: keys "\n" echo "\r\n"
control: read "\x01\n" EAGAIN
interrupt: keys "\x16\x03" echo "^\b^C"
interrupt: keys "\n" echo "\r\n"
interrupt: read "\x03\n" EAGAIN
eof: keys "a\x16\x04" echo "a^\b^D"
eof: keys "\n" echo "\r\n"
eof: read "a\x04\n" EAGAIN
erase: keys "ab\x16\x7f" echo "ab^\b^?"
erase: keys "\n" echo "\r\n"
erase: read "ab\x7f\n" EAGAIN
kill: keys "ab\x16\x15" echo "ab^\b^U"
kill: keys "\n" echo "\r\n"
kill: read "ab\x15\n" EAGAIN
newline: keys "a\x16\nb" echo "a^\b^Jb"
newline: keys "\n" echo "\r\n"
newline: read "a\nb\n" EAGAIN
return: keys "a\x16\rb" echo "a^\b^Mb"
return: keys "\n" echo "\r\n"
return: read "a\rb\n" EAGAIN
itself: keys "\x16\x16" echo "^\b^V"
itself: keys "\n" echo "\r\n"
itself: read "\x16\n" EAGAIN
werase: keys "ab\x16\x17" echo "ab^\b^W"
werase: keys "\n" echo "\r\n"
werase: read "ab\x17\n" EAGAIN
reprint: keys "ab\x16\x12" echo "ab^\b^R"
reprint: keys "\n" echo "\r\n"
reprint: read "ab\x12\n" EAGAIN
erased: keys "ab\x16\x01\x7f" echo "ab^\b^A\b \b\b \b"
erased: keys "\n" echo "\r\n"
erased: read "ab\n" EAGAIN
erased before next: keys "ab\x16\x7f" echo "ab^\b^?"
erased before next: keys "\n" echo "\r\n"
erased before next: read "ab\x7f\n" EAGAIN
plain letter: keys "\x16q" echo "^\bq"
plain letter: keys "\n" echo "\r\n"
plain letter: read "q\n" EAGAIN
no echo: keys "\x16\x03" echo ""
no echo: keys "\n" echo ""
no echo: read "\x03\n" EAGAIN
no echoctl: keys "\x16\x03" echo "\x03"
no echoctl: keys "\n" echo "\r\n"
no echoctl: read "\x03\n" EAGAIN
no iexten: keys "a\x16\x7f" echo "a^V\b \b\b \b"
no iexten: keys "\n" echo "\r\n"
no iexten: read "a\n" EAGAIN
no isig: keys "\x16\x03" echo "^\b^C"
no isig: keys "\n" echo "\r\n"
no isig: read "\x03\n" EAGAIN
reprint with literal: keys "a\x16\x01b\x12" echo "a^\b^Ab^R\r\na^Ab"
reprint with literal: keys "\n" echo "\r\n"
reprint with literal: read "a\x01b\n" EAGAIN

== L3 not implemented by Linux
VDISCARD: keys "ab\x0fcd" echo "ab^Ocd"
VDISCARD: keys "\n" echo "\r\n"
VDISCARD: read "ab\x0fcd\n" EAGAIN
VDISCARD no iexten: keys "ab\x0fcd" echo "ab^Ocd"
VDISCARD no iexten: keys "\n" echo "\r\n"
VDISCARD no iexten: read "ab\x0fcd\n" EAGAIN
VSWTC: keys "ab!cd\n" echo "ab!cd\r\n"
VSWTC: read "ab!cd\n" EAGAIN

== L3 VEOL2
iexten: keys "pc%rest\n" echo "pc%rest\r\n"
iexten: read "pc%" "rest\n" EAGAIN
iexten: keys "ctl\x18" echo "ctl^X"
iexten: read "ctl\x18" EAGAIN
no iexten: keys "pc%rest\n" echo "pc%rest\r\n"
no iexten: read "pc%rest\n" EAGAIN
no iexten: keys "ctl\x18" echo "ctl^X"
no iexten: read EAGAIN
no echo: keys "pc%rest\n" echo ""
no echo: read "pc%" "rest\n" EAGAIN
no echo: keys "ctl\x18" echo ""
no echo: read "ctl\x18" EAGAIN

