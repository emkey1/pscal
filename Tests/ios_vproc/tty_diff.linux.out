== L5 IUTF8
two bytes: keys "a\xc3\xa9\x7f" echo "a\xc3\xa9\b \b"
two bytes: keys "\n" echo "\r\n"
two bytes: read "a\n" EAGAIN
three bytes: keys "a\xe6\x97\xa5\x7f" echo "a\xe6\x97\xa5\b \b"
three bytes: keys "\n" echo "\r\n"
three bytes: read "a\n" EAGAIN
four bytes: keys "a\xf0\x9f\x98\x80\x7f" echo "a\xf0\x9f\x98\x80\b \b"
four bytes: keys "\n" echo "\r\n"
four bytes: read "a\n" EAGAIN
erase twice: keys "a\xc3\xa9\xc3\xa8\x7f\x7f" echo "a\xc3\xa9\xc3\xa8\b \b\b \b"
erase twice: keys "\n" echo "\r\n"
erase twice: read "a\n" EAGAIN
lone continuation: keys "a\xa9\x7f" echo "a\xa9\b \b"
lone continuation: keys "\n" echo "\r\n"
lone continuation: read "\n" EAGAIN
off: keys "a\xc3\xa9\x7f" echo "a\xc3\xa9\b \b"
off: keys "\n" echo "\r\n"
off: read "a\xc3\n" EAGAIN
off, twice: keys "a\xc3\xa9\x7f\x7f" echo "a\xc3\xa9\b \b\b \b"
off, twice: keys "\n" echo "\r\n"
off, twice: read "a\n" EAGAIN
no echoe: keys "a\xc3\xa9\x7fb" echo "a\xc3\xa9^?b"
no echoe: keys "\n" echo "\r\n"
no echoe: read "ab\n" EAGAIN
then more: keys "a\xc3\xa9\x7fb" echo "a\xc3\xa9\b \bb"
then more: keys "\n" echo "\r\n"
then more: read "ab\n" EAGAIN
kill: keys "a\xc3\xa9b\x15" echo "a\xc3\xa9b\b \b\b \b\b \b"
kill: keys "\n" echo "\r\n"
kill: read "\n" EAGAIN
werase: keys "x a\xc3\xa9b\x17" echo "x a\xc3\xa9b\b \b\b \b\b \b"
werase: keys "\n" echo "\r\n"
werase: read "x \n" EAGAIN
werase, off: keys "x a\xc3\xa9b\x17" echo "x a\xc3\xa9b\b \b"
werase, off: keys "\n" echo "\r\n"
werase, off: read "x a\xc3\xa9\n" EAGAIN
tab after: keys "\xc3\xa9\t\x7f" echo "\xc3\xa9\t\b\b\b\b\b\b\b"
tab after: keys "\n" echo "\r\n"
tab after: read "\xc3\xa9\n" EAGAIN
tab after, off: keys "\xc3\xa9\t\x7f" echo "\xc3\xa9\t\b\b\b\b\b\b"
tab after, off: keys "\n" echo "\r\n"
tab after, off: read "\xc3\xa9\n" EAGAIN
reprint: keys "\xc3\xa9b\x12" echo "\xc3\xa9b^R\r\n\xc3\xa9b"
reprint: keys "\n" echo "\r\n"
reprint: read "\xc3\xa9b\n" EAGAIN
tab3 output, iutf8: "\xc3\xa9       |"

== L5 L7 a long line
echoed letters 6000, bells none, others 0
erase at the limit: keys "\x7f" echo "\b \b"
more at the limit: keys "y" echo "y"
one too many: keys "z" echo "z"
newline: keys "\n" echo "\r\n"
read 4096, last two "y\n"
after: read EAGAIN
the end-of-file key at the limit: keys "\x04" echo ""
read 4095
after: read EAGAIN
VEOL at the limit: keys "%" echo "%"
read 4096
after: read EAGAIN
kill at the limit: keys "\x15a\n" echo ""
after: read "a\n" EAGAIN

== L7 input flags, in line mode
istrip: keys "a\xe1\xb1" echo "aa1"
istrip: keys "\n" echo "\r\n"
istrip: read "aa1\n" EAGAIN
istrip return: keys "\x8db" echo "\r\nb"
istrip return: keys "\n" echo "\r\n"
istrip return: read "\n" "b\n" EAGAIN
istrip key: keys "ab\xffc" echo "ab\b \bc"
istrip key: keys "\n" echo "\r\n"
istrip key: read "ac\n" EAGAIN
iuclc: keys "aBcD" echo "abcd"
iuclc: keys "\n" echo "\r\n"
iuclc: read "abcd\n" EAGAIN
iuclc no iexten: keys "aBcD" echo "aBcD"
iuclc no iexten: keys "\n" echo "\r\n"
iuclc no iexten: read "aBcD\n" EAGAIN
inlcr: keys "a\nb" echo "a^Mb"
inlcr: keys "\n" echo "^M"
inlcr: read EAGAIN
igncr: keys "a\rb" echo "ab"
igncr: keys "\n" echo "\r\n"
igncr: read "ab\n" EAGAIN
igncr no icrnl: keys "a\rb" echo "ab"
igncr no icrnl: keys "\n" echo "\r\n"
igncr no icrnl: read "ab\n" EAGAIN
inlcr icrnl: keys "a\nb\rc" echo "a^Mb\r\nc"
inlcr icrnl: keys "\n" echo "^M"
inlcr icrnl: read "a\rb\n" EAGAIN
inlcr igncr: keys "a\nb\rc" echo "a^Mbc"
inlcr igncr: keys "\n" echo "^M"
inlcr igncr: read EAGAIN
no translation: keys "a\rb" echo "a^Mb"
no translation: keys "\n" echo "\r\n"
no translation: read "a\rb\n" EAGAIN
ignbrk: keys "a" echo "a"
ignbrk: keys "\n" echo "\r\n"
ignbrk: read "a\n" EAGAIN
brkint: keys "a" echo "a"
brkint: keys "\n" echo "\r\n"
brkint: read "a\n" EAGAIN
inpck: keys "a\xffb" echo "a\xffb"
inpck: keys "\n" echo "\r\n"
inpck: read "a\xffb\n" EAGAIN
ignpar: keys "a\xffb" echo "a\xffb"
ignpar: keys "\n" echo "\r\n"
ignpar: read "a\xffb\n" EAGAIN
parmrk: keys "a\xffb" echo "a\xffb"
parmrk: keys "\n" echo "\r\n"
parmrk: read "a\xff\xffb\n" EAGAIN
parmrk inpck: keys "a\xffb" echo "a\xffb"
parmrk inpck: keys "\n" echo "\r\n"
parmrk inpck: read "a\xff\xffb\n" EAGAIN
parmrk istrip: keys "a\xffb" echo "a\b \bb"
parmrk istrip: keys "\n" echo "\r\n"
parmrk istrip: read "b\n" EAGAIN
imaxbel: keys "a" echo "a"
imaxbel: keys "\n" echo "\r\n"
imaxbel: read "a\n" EAGAIN

== L7 input flags, raw
istrip: keys "a\xe1\xb1" echo ""
istrip: read "aa1" EAGAIN
iuclc: keys "aBcD" echo ""
iuclc: read "abcd" EAGAIN
iuclc no iexten: keys "aBcD" echo ""
iuclc no iexten: read "aBcD" EAGAIN
parmrk: keys "a\xffb" echo ""
parmrk: read "a\xff\xffb" EAGAIN
parmrk istrip: keys "a\xffb" echo ""
parmrk istrip: read "a\x7fb" EAGAIN

